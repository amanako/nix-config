{
  "display": {
    "brightColor": true,
    "color": {
      "output": "white"
    },
    "key": {
      "type": "string",
      "width": 20
    },
    "separator": ""
  },
  "logo": {
    "color": {
      "1": "blue"
    },
    "padding": {
      "top": 1,
      "bottom": 0,
      "left": 1,
      "right": 2
    },
    "recache": true,
    "chafa": {
      "fgOnly": true
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;212;190;152m┌─────\u001b[38;2;211;134;155m────\u001b[0m\u001b[0m\u001b[38;2;231;138;78m────\u001b[0m\u001b[38;2;169;182;101m────\u001b[0m\u001b[38;2;234;105;98m────\u001b[0m\u001b[38;2;125;174;163m────Info────\u001b[0m\u001b[38;2;234;105;98m────\u001b[0m\u001b[38;2;169;182;101m────\u001b[0m\u001b[38;2;231;138;78m────\u001b[0m\u001b[38;2;211;134;155m────\u001b[0m─────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "bright_red"
    },
    {
      "type": "kernel",
      "key": "󰝨  Kernel",
      "keyColor": "bright_red"
    },
    {
      "type": "packages",
      "key": "󰏗  Packages",
      "keyColor": "green",
      "combined": true
    },
    {
      "type": "disk",
      "key": "  Disk",
      "keyColor": "green"
    },
    {
      "type": "lm",
      "key": "  LM",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "󱂬  WM",
      "keyColor": "bright_yellow"
    },
    {
      "type": "editor",
      "key": "󰯂  Editor",
      "keyColor": "yellow"
    },

    {
      "type": "terminal",
      "key": "󰆍  Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "terminalfont",
      "key": "  Font",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "  OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /nix)) / 86400 )) days"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;212;190;152m└─────\u001b[38;2;211;134;155m────\u001b[0m\u001b[0m\u001b[38;2;231;138;78m────\u001b[0m\u001b[38;2;169;182;101m────\u001b[0m\u001b[38;2;234;105;98m────\u001b[0m\u001b[38;2;125;174;163m────────────\u001b[0m\u001b[38;2;234;105;98m────\u001b[0m\u001b[38;2;169;182;101m────\u001b[0m\u001b[38;2;231;138;78m────\u001b[0m\u001b[38;2;211;134;155m────\u001b[0m─────┘\u001b[0m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0,
      "block": {
        "width": 7,
        "range": [
          0,
          15
        ]
      }
    }
  ],
  "schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json"
}
