window-rule {
    opacity 0.87
    background-effect {
        blur true
    }
}

layer-rule {
    exclude namespace="^main$"
    opacity 0.87
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^main$"
    opacity 0.87
    geometry-corner-radius 12
    background-effect {
        blur true
    }
}

blur {
    passes 5
    offset 2.0
    saturation 3
}
